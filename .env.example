# Copy to .env and fill in. Never commit .env.

# --- General ---
BASE_URL=http://localhost:8000
# Random string, e.g. python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me
# Leave empty for local use; REQUIRED when deployed to the cloud
APP_PASSWORD=

# --- AI (claude | ollama) ---
LLM_PROVIDER=claude
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-opus-5-5
# Used for bulk job scoring and email classification; a cheaper model (e.g. claude-haiku-4-5) cuts cost
CLAUDE_SCORING_MODEL=claude-opus-5-5
CLAUDE_FALLBACKS=true
OLLAMA_URL=http://host.docker.internal:11434
OLLAMA_MODEL=llama3.1

# --- Job sources ---
# Optional RapidAPI key for JSearch (Google for Jobs: LinkedIn, Indeed, Glassdoor, Profession.hu listings).
# Free tier ~200 requests/month. https://rapidapi.com/letscrape-6bRBa3QguO5/api/jsearch
JSEARCH_API_KEY=
ENABLE_REMOTIVE=true
ENABLE_ARBEITNOW=true
ENABLE_REMOTEOK=true

# --- Gmail (Google Cloud OAuth client, type "Web application") ---
# Authorized redirect URI: <BASE_URL>/gmail/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Scheduling / limits ---
SEARCH_INTERVAL_HOURS=6
EMAIL_SYNC_MINUTES=30
MAX_LLM_SCORES_PER_RUN=25
AUTO_PREPARE_DRAFTS=true
MAX_DRAFTS_PER_RUN=5
EMAIL_LOOKBACK_DAYS=30
